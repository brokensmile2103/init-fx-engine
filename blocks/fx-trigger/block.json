{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "init-fx-engine/fx-trigger",
	"version": "2.0.3",
	"title": "FX Trigger",
	"category": "init-fx-engine",
	"icon": "star-filled",
	"description": "Insert a link or button that fires a visual effect (fireworks, emoji rain, etc.) on click, hover, when scrolled into view or right away.",
	"keywords": [ "fx", "effect", "fireworks", "confetti", "init" ],
	"textdomain": "init-fx-engine",
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		},
		"fx": {
			"type": "string",
			"default": "firework"
		},
		"emoji": {
			"type": "string",
			"default": ""
		},
		"shoot": {
			"type": "string",
			"default": "click"
		},
		"tag": {
			"type": "string",
			"default": "a"
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"editorScript": "init-fx-engine-blocks-editor",
	"render": "file:./render.php"
}
